{
  "dev-loop": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {"type": "command", "command": "python3 \"${DEVLOOP_HOOKS}/antigravity/devloop-hook.py\" guard", "timeout": 10}
        ]
      },
      {
        "matcher": "file_change|propose_code|edit_notebook|write_blob",
        "hooks": [
          {"type": "command", "command": "python3 \"${DEVLOOP_HOOKS}/antigravity/devloop-hook.py\" no-env", "timeout": 10}
        ]
      }
    ],
    "PreInvocation": [
      {"type": "command", "command": "python3 \"${DEVLOOP_HOOKS}/antigravity/devloop-hook.py\" invocation", "timeout": 15}
    ],
    "Stop": [
      {"type": "command", "command": "python3 \"${DEVLOOP_HOOKS}/antigravity/devloop-hook.py\" stop-gate", "timeout": 20}
    ]
  }
}
